# The key for whichever paid feed you point TRACE at.
#
# It belongs in your environment and nowhere else. config.toml has a slot for
# it and you should leave that slot empty: a key in a file is a key in a
# screenshot, in a backup, and eventually in a repository.
#
#   twitterapi.io (the default, $0.15 per 1 000 posts)
TRACE_X_BEARER=new1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
#   or the official X API ($5.00 per 1 000 posts) with provider = "x"
#   in config.toml
# TRACE_X_BEARER=AAAAAAAAAAAAAAAAAAAAA...

# Nothing else is read from the environment. There is no key, seed or signer
# anywhere in this project - see docs/SAFETY.md.
